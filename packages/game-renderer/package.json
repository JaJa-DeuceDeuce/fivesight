{
  "name": "@fivesight/game-renderer",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./Game": {
      "types": "./dist/game.d.ts",
      "import": "./dist/game.js"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "import": "./dist/types.js"
    }
  },
  "scripts": {
    "dev": "tsc --watch",
    "build": "tsc"
  },
  "peerDependencies": {
    "react": "^18 || ^19",
    "react-dom": "^18 || ^19"
  },
  "dependencies": {
    "@pixi/react": "^8.0.5",
    "pixi.js": "^8.15.0"
  },
  "devDependencies": {
    "@fivesight/typescript-config": "workspace:*",
    "@types/react": "^19.2.9",
    "@types/react-dom": "^19.2.3",
    "typescript": "^5.9.3"
  }
}
